# Native development settings: copy to backend/.env (gitignored) and fill in. Every value is an SDMS_* setting.
# Run it with:  python dev.py     (sets SDMS_SEED_DEMO=true and SDMS_ENABLE_DOCS=true unless you override them)

# Use a least-privilege role (CREATEDB is only needed to run the test-suite), NOT the postgres superuser:
#   CREATE ROLE sdms_app LOGIN PASSWORD '...' CREATEDB;   CREATE DATABASE sdms OWNER sdms_app;
SDMS_DATABASE_URL=postgresql+psycopg://sdms_app:CHANGE_ME@localhost:5432/sdms
SDMS_MONGO_URL=mongodb://localhost:27017
SDMS_MONGO_DB=sdms

# Hyperledger Fabric REST gateway and the AI service, started by:  docker compose up -d ledger-gateway ai
# Copy the two keys from the root .env (python deploy/gen_env.py writes it).
SDMS_LEDGER_BACKEND=fabric
SDMS_FABRIC_GATEWAY_URL=http://127.0.0.1:8088
SDMS_FABRIC_GATEWAY_KEY=CHANGE_ME
SDMS_AI_SERVICE_URL=http://127.0.0.1:9000
SDMS_AI_SERVICE_KEY=CHANGE_ME

# Optional. Generated into backend/data/ on first run if unset - set them (and keep them safe) for anything real.
# SDMS_MASTER_KEY=      # base64 of 32 random bytes; encrypts every stored document. Losing it = losing the documents.
# SDMS_JWT_SECRET=
